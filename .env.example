# BKT AI-Apply — environment variable inventory
# ----------------------------------------------------------------------------
# Copy to `.env` for local dev (`.env` is gitignored). NEVER commit real secrets.
# Two distinct surfaces:
#   1) CLIENT (VITE_*)  — bundled into the SPA; set in Vercel → Project →
#      Settings → Environment Variables. These are PUBLIC (anon key + URL only).
#   2) EDGE FUNCTION SECRETS — server-side only, set with
#      `supabase secrets set NAME=value`. NEVER prefixed VITE_, never shipped to
#      the browser (BR-006 / BR-122 / SEC-004).
# ============================================================================

# ── 1) Client (Vite) — safe to expose ──────────────────────────────────────
# Supabase project URL + anon (publishable) key. RLS protects all data.
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── 2) Supabase Edge Function secrets (server-side only) ────────────────────
# Auto-injected by the Supabase platform — DO NOT set these manually:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Multi-model LLM providers (see supabase/functions/_shared/llm/factory.ts).
# Each provider accepts the first non-empty alias listed. Configure the
# provider(s) you use; others degrade gracefully (provider-status reports them).
ANTHROPIC_KEY="sk-ant-..."          # or ANTHROPIC_API_KEY
OPENAI_KEY="sk-..."                 # or OPENAI_API_KEY
GEMINI_KEY="..."                    # or GOOGLE_API_KEY / GEMINI_API_KEY

# Prospector job discovery (prospector-cron).
SERPAPI_KEY="your-serpapi-key"

# Gmail ingestion + send (gmail-sync / gmail-send).
GOOGLE_OAUTH_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="..."
GMAIL_REFRESH_TOKEN="..."
GMAIL_USER_EMAIL="john@bktadvisory.com"

# Submission worker controls (submission-worker Edge Function).
# Full operational detail in docs/deploy/submission-worker-setup.md.
#   SUBMISSION_LIVE       — KILL-DEFAULT safety gate. Must be the EXACT string
#                           'true' to send REAL applications. Anything else
#                           (including unset) = zero-side-effect dry run. Leave
#                           unset/"false" until you intend to submit for real.
#   SUBMISSION_BATCH_SIZE — max 'approved' rows processed per run (default 10).
#   CRON_SECRET           — locks the --no-verify-jwt endpoint. When set, every
#                           invocation must carry it ('x-cron-secret' header or
#                           'Authorization: Bearer <CRON_SECRET>') or it gets 401.
#                           Unset is open ONLY in dry-run; with SUBMISSION_LIVE=
#                           true and no CRON_SECRET the worker fails closed (503).
#                           REQUIRED before going live — set a long random value.
SUBMISSION_LIVE="false"
SUBMISSION_BATCH_SIZE="10"
CRON_SECRET="<long-random-string>"

# Auto-submission browser channel (Phase 4 — Browserbase + Stagehand).
# Used by the submission worker only when a posting falls back to the browser
# channel (jobs.application_method not api/ats). Absent key => browser channel
# reports "not configured" and the posting fails to manual (never crashes).
BROWSERBASE_API_KEY="bb_..."
BROWSERBASE_PROJECT_ID="..."

# ── 3) AI UAT — automated browser testing agent ─────────────────────────────
# Dedicated test account (NEVER your real credentials).
# Create a Supabase auth user just for testing: Settings → Authentication.
TEST_USER_EMAIL="uat-test@bktadvisory.com"
TEST_USER_PASSWORD="!Gdf!Sob!04!"

# Override the AI UAT target URL. Defaults to the active Codespace dev URL,
# then falls back to http://localhost:5173. For production runs, set:
#   AI_UAT_BASE_URL=https://bkt-ai-apply.vercel.app
AI_UAT_BASE_URL=""

# Anthropic model used by the Stagehand AI agent (see model-routing.md).
# Default: claude-3-5-sonnet-latest
AI_UAT_MODEL="claude-3-5-sonnet-latest"

